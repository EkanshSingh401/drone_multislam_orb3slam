@@ -47,6 +47,23 @@ using namespace ov_core;
 using namespace ov_type;
 using namespace ov_msckf;
 
+// Day 5 diagnostic (drone_multislam_orb3slam docs/day5, ov_stage_logdet.patch): with OV_STAGE_LOGDET set,
+// print log det of the IMU pose marginal (6x6 [dth dp]) and of its orientation block after each
+// update stage. Default off; no effect on the estimate.
+static void stage_logdet(const std::shared_ptr<ov_msckf::State> &state, const char *stage, size_t n) {
+  static const bool on = std::getenv("OV_STAGE_LOGDET") != nullptr;
+  if (!on)
+    return;
+  std::vector<std::shared_ptr<ov_type::Type>> v{state->_imu->pose()};
+  Eigen::MatrixXd P = ov_msckf::StateHelper::get_marginal_covariance(state, v);
+  P = 0.5 * (P + P.transpose());
+  Eigen::LLT<Eigen::MatrixXd> l6(P), l3(P.block(0, 0, 3, 3)), l2(P.block(0, 0, 2, 2));
+  auto ld = [](const Eigen::LLT<Eigen::MatrixXd> &l) { return 2.0 * l.matrixL().toDenseMatrix().diagonal().array().log().sum(); };
+  std::printf("[STAGE] %.6f %s %.9f %.9f %.9f %zu %zu %zu\n", state->_timestamp, stage, ld(l6), ld(l3), ld(l2), n,
+              state->_features_SLAM.size(), state->_clones_IMU.size());
+}
+
+
